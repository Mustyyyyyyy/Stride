# Stride Fitness Tracker - Environment Variables
# Copy this file to backend/.env and fill in your values

# Database connection string (PostgreSQL required)
# Example for local Postgres:
# DATABASE_URL="postgresql://stride:stride@localhost:5432/stridedb"
# Example for Neon / Supabase / Railway:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Backend server port
PORT=3004

# Environment mode: development | production | test
NODE_ENV=development

# Allowed CORS origin(s) for the web/mobile clients
# Use comma-separated values in production
CORS_ORIGIN="http://localhost:5173"

# JWT signing secrets (use strong random strings in production)
JWT_SECRET="change-me-in-production"
JWT_EXPIRATION="15m"

JWT_REFRESH_SECRET="change-me-in-production-too"
JWT_REFRESH_EXPIRATION="30d"

# Demo mode flag (if true, certain endpoints may return demo data)
USE_DEMO=false
