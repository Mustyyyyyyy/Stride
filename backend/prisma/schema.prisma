datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String?
  fullName         String
  profilePhoto     String?
  height           Float?          // in cm
  weight           Float?          // in kg
  gender           String?         @default("PREFER_NOT_TO_SAY")
  dateOfBirth      DateTime?
  unitSystem       String          @default("METRIC")
  theme            String          @default("SYSTEM")
  provider         String?         @default("email") // email | google | apple
  firebaseUid      String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  refreshTokens    RefreshToken[]
  activities       Activity[]
  goals            Goal[]
  userAchievements UserAchievement[]
  notifications    Notification[]
  devices          Device[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Activity {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  title        String?
  distance     Float        // in meters
  duration     Int          // in seconds
  calories     Float        // in kcal
  averageSpeed Float        // in m/s
  maxSpeed     Float        // in m/s
  averagePace  Float        // in min/km
  steps        Int          @default(0)
  startLocation String?
  endLocation   String?
  polyline     String?      // encoded route polyline or JSON string
  notes        String?
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime     @default(now())

  gpsPoints    GpsPoint[]
}

model GpsPoint {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  altitude   Float?   @default(0.0)
  speed      Float?   @default(0.0)   // in m/s
  accuracy   Float?   @default(0.0)   // in meters
  timestamp  DateTime
}

model Goal {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  targetValue     Float    // steps, meters, or calories
  currentProgress Float    @default(0.0)
  startDate       DateTime
  endDate         DateTime?
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  icon             String
  category         String
  metricThreshold  Float?
  createdAt        DateTime          @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Device {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())
}
